  "texts": [],
  "projects": [
    {
      "id": "pmwgp92xn",
      "title": {
        "he": "פני השטח",
        "en": "Surfaces"
      },
      "description": {
        "he": "תצלומי תקריב של עור וצלקות נקרעים, נחתכים ומורכבים מחדש. הצלקת, סימן לחיבור שנוצר בגוף, פוגשת את הקרעים והרווחים בנייר. בין החלקים נוצר נוף חדש, שבו העור נותר מזוהה ובה בעת הופך למרקם, לצבע ולצורה.",
        "en": "Close-up photographs of skin and scars are torn, cut and reassembled. The scar—a trace of the body knitting itself back together—meets the tears and gaps in the paper. A new landscape emerges, where skin remains recognisable even as it becomes texture, colour and form."
      }
    },
    {
      "id": "pmwgtpfnj",
      "title": {
        "he": "סדר אחר",
        "en": "Another Order"
      },
      "description": {
        "he": "פרטים שנמצאו בשיטוט מצולמים, מודפסים ומסודרים מחדש. באמצעות חיתוך, חזרה והזזה, עלים ומשטחים סדוקים יוצאים מהקשרם המקורי. קווים ממשיכים בין תצלומים או נקטעים בגבולותיהם, והרווחים בין החלקים משתתפים ביצירת סדר אחר.",
        "en": "Details encountered while wandering are photographed, printed and rearranged. Through cutting, repetition and displacement, leaves and cracked surfaces are drawn out of their original surroundings. Lines continue from one photograph to another or break at their edges, while the gaps between fragments help shape another order."
      }
    },
    {
      "id": "pmwgz0lhv",
      "title": {
        "he": "בשניים x במקרה",
        "en": "Twos x Chance"
      },
      "description": {
        "he": "אנשים, פסלים, חפצים והשתקפויות נפגשים בזוגות בתוך הפריים. סמיכות מקרית, אולי.",
        "en": "People, statues, objects and reflections meet in pairs within the frame. By chance, perhaps."
      }
    }
  ]
}
